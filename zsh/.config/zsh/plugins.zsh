# Fuzzy finder: Ctrl-R history, Ctrl-T files, Alt-C directories (https://github.com/junegunn/fzf)
source <(fzf --zsh)

# Suggestions from history (https://github.com/zsh-users/zsh-autosuggestions)
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Syntax highlighting, loaded last (https://github.com/zdharma-continuum/fast-syntax-highlighting)
source $HOMEBREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
